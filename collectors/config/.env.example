# 采集器本地配置模板

# 财务软件类型：demo | yonyou-u8 | kingdee-k3 | sap | custom
FINANCE_SYSTEM_TYPE=demo

# 财务软件接口地址
FINANCE_BASE_URL=http://localhost:9000

# 财务软件访问凭证，不要提交真实密钥
FINANCE_API_KEY=change-me

# MQ 配置
COLLECTOR_MQ_ENABLED=false
COLLECTOR_MQ_URL=amqp://guest:guest@localhost:5672/
COLLECTOR_REQUEST_TOPIC=collector.tasks.finance
COLLECTOR_RESULT_TOPIC=collector.results
