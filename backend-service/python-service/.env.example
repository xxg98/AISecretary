PYTHON_SERVICE_NAME=kai-lei-python-service
PYTHON_ENV=dev
PYTHON_DEBUG=true
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8090
JAVA_SERVICE_BASE_URL=http://localhost:8083
JAVA_SERVICE_TIMEOUT_SECONDS=10
MQ_ENABLED=false
MQ_BROKER=rabbitmq
MQ_URL=amqp://guest:guest@localhost:5672/
MQ_EXCHANGE=kai.lei.ai.secretary
MQ_REQUEST_QUEUE=python.tasks
MQ_RESULT_QUEUE=java.callbacks
REDIS_URL=redis://localhost:6379/1
